# ==============================================================================
# Small Software Cloud - Environment Variables
# ==============================================================================

# Next.js Public Site URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic Claude API Key (Server-side only, never reaches browser)
# Optional locally: if omitted, AI generation proxies through SHARE_GATEWAY_URL
# (or AI_PROXY_URL) when pointed at your deployed Vercel app, or falls back to
# the built-in offline generator.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Sandbox Hosting Origin (Optional: can be a separate domain/subdomain for iframe isolation)
NEXT_PUBLIC_SANDBOX_ORIGIN=http://localhost:3000

# ==============================================================================
# Share CLI (npm run share)
# These can also be saved from the dashboard into
# ~/.config/small-software-cloud/credentials.json (never into your project).
# ==============================================================================
# Public gateway that serves /s/<token> links (your deployed app URL in production)
SHARE_GATEWAY_URL=http://localhost:3000
# Port for the local dashboard (bound to 127.0.0.1 only)
SHARE_DASHBOARD_PORT=4040
